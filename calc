import sys
import math


#入力処理
def tokenize(form):
    formula = []
    n = 0 
    number = ""
    
    while n < len(form):
        if form[n].isdigit():
            while n < len(form) and (form[n].isdigit() or form[n] == "."):
                number += form[n]
                n += 1

            formula.append(number)
            number = ""

        elif form[n] in "+-*/()":
            formula.append(form[n])
            n += 1

        elif form[n:n+3] == "sin" or form[n:n+3] == "cos" or form[n:n+3] == "tan":
            formula.append(form[n:n+3])
            n += 3

        elif form[n:n+2] == "pi":
            formula.append(math.pi)
            n += 2

        else:
            n += 1


    for i in range(len(formula)):
        try:
            formula[i] = float(formula[i])

        except ValueError:
            pass

    formula = minus(formula)
    return formula


#四則演算の実行
def arithmetic(form):
    form = minus(form)
    if "*" in form or "/" in form:
        form = MulDiv(form)

    if "+" in form or "-" in form:
        form = AddSub(form)

    return form


#減算と負号の区別
def minus(form):
    n = 0
    while n < len(form):
        if form[n] == "-" and (n == 0 or form[n-1] in ["+","-","*","/","(","sin","cos","tan"]):
            if isinstance(form[n+1],(int,float)):
                form[n:n+2] = [form[n+1] * -1]

        n += 1

    return form


#三角関数の処理
def trigonometric(form):
    n = 0

    while n < len(form):
        if form[n] == "sin":

            form[n:n+2] = [math.sin(math.radians(form[n+1]))]
            n += 1

        elif form[n] == "cos":
            form[n:n+2] = [math.cos(math.radians(form[n+1]))]
            n += 1

        elif form[n] == "tan":
            form[n:n+2] = [math.tan(math.radians(form[n+1]))]
            n += 1

        else:
            n += 1

    return form


#括弧の優先処理
def priority(form):
    n = 0
    depth = 0

    while n < len(form):
        if form[n] == "(":
            paren = []
            first = n
            n += 1
            depth += 1

            while depth > 0:

                if form[n] == "(":
                    depth += 1
                    paren.append(form[n])
                    n += 1

                elif form[n] == ")":
                    depth -= 1

                    if depth == 0:
                        paren = priority(paren)
                        break

                    else:
                        paren.append(form[n])
                        n += 1

                else:
                    paren.append(form[n])
                    n += 1

            paren = trigonometric(paren)
            paren = arithmetic(paren)
            form[first:n+1] = paren
            n = first

        else:
            n += 1

    return form 


#乗除の計算
def MulDiv(form):

    n = 0

    while n < len(form): 
        if form[n] == "*":
            ans = form[n-1] * form[n+1]
            form[n-1:n+2] = [ans]
            n = n-1

        elif form[n] == "/":
            ans = form[n-1] / form[n+1]
            form[n-1:n+2] = [ans]
            n = n-1

        else:
            n += 1

    return form


#加減の計算
def AddSub(form):
    
    n = 0
    
    while n < len(form):
        if form[n] == "+":
            ans = form[n-1] + form[n+1]
            form[n-1:n+2] = [ans]
            n = n-1

        elif form[n] == "-":
            ans = form[n-1] - form[n+1]
            form[n-1:n+2] = [ans]
            n = n-1

        else:
            n += 1

    return form


formula = tokenize(input())

if "(" in formula:
    formula = priority(formula)

if "sin" in formula or "cos" in formula or "tan" in formula:
    formula = trigonometric(formula)

formula = arithmetic(formula)

print(formula[0])
