import sys
import math


formula = input().split()
for i in range(len(formula)):
    try:
        formula[i] = float(formula[i])

    except ValueError:
        pass


numbers = []
operators = []
others = []

for i in range(len(formula)):
    try:
        numbers.append(float(formula[i]))

    except ValueError:
        if formula[i] in ["*","/","+","-"]:
            operators.append(formula[i])

        else:
            others.append(formula[i])

print(formula)
print(numbers)
print(operators)
print(others)

