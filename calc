n = 0
m = 0

while n < len(formula): 
    if formula[n] == "*":
        ans = formula[n-1] * formula[n+1]
        formula[n-1:n+2] = [ans]
        n = n-1

    elif formula[n] == "/":
        ans = formula[n-1] / formula[n+1]
        formula[n-1:n+2] = [ans]
        n = n-1

    else:
        n += 1

while m < len(formula):
    if formula[m] == "+":
        ans = formula[m-1] + formula[m+1]
        formula[m-1:m+2] = [ans]
        m = m-1

    elif formula[m] == "-":
        ans = formula[m-1] - formula[m+1]
        formula[m-1:m+2] = [ans]
        m = m-1

    else:
        m += 1

print(formula)
