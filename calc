import sys
import math


def MulDiv(formula):

    n = 0

    while n < len(formula): 
        if formula[n] == "*":
            ans = formula[n-1] * formula[n+1]
            formula[n-1:n+2] = [ans]
            n = n-1

        elif formula[n] == "/":
            ans = formula[n-1] / formula[n+1]
            formula[n-1:n+2] = [ans]
            n = n-1

        else:
            n += 1

    return formula


def AddSub(formula):
    
    n = 0
    
    while n < len(formula):
        if formula[n] == "+":
            ans = formula[n-1] + formula[n+1]
            formula[n-1:n+2] = [ans]
            n = n-1

        elif formula[n] == "-":
            ans = formula[n-1] - formula[n+1]
            formula[n-1:n+2] = [ans]
            n = n-1

        else:
            n += 1

    return formula


formula = input().split()

for i in range(len(formula)):
    try:
        formula[i] = float(formula[i])

    except ValueError:
        pass

if "*" in formula or "/" in formula:
    formula = MulDiv(formula)

if "+" in formula or "-" in formula:
    formula = AddSub(formula)

print(formula)



