import sys
import math


def arithmetic(form):
    if "*" in form or "/" in form:
        form = MulDiv(form)

    if "+" in form or "-" in form:
        form = AddSub(form)

    return form


def trigonometric(form):
    n = 0

    while n < len(form):
        if form[n] == "sin":

            form[n:n+2] = [math.sin(math.radians(form[n+1]))]
            n += 1

        elif form[n] == "cos":
            form[n:n+2] = [math.cos(math.radians(form[n+1]))]
            n += 1

        elif form[n] == "tan":
            form[n:n+2] = [math.tan(math.radians(form[n+1]))]
            n += 1

        else:
            n += 1

    return form


def priority(form):
    n = 0
    depth = 0

    while n < len(form):
        if form[n] == "(":
            paren = []
            first = n
            n += 1
            depth += 1

            while depth > 0:

                if form[n] == "(":
                    depth += 1
                    paren.append(form[n])
                    n += 1

                elif form[n] == ")":
                    depth -= 1

                    if depth == 0:
                        paren = priority(paren)
                        break

                    else:
                        paren.append(form[n])
                        n += 1

                else:
                    paren.append(form[n])
                    n += 1

            paren = trigonometric(paren)
            paren = arithmetic(paren)
            form[first:n+1] = paren
            n = first

        else:
            n += 1

    return form


def MulDiv(formula):

    n = 0

    while n < len(formula): 
        if formula[n] == "*":
            ans = formula[n-1] * formula[n+1]
            formula[n-1:n+2] = [ans]
            n = n-1

        elif formula[n] == "/":
            ans = formula[n-1] / formula[n+1]
            formula[n-1:n+2] = [ans]
            n = n-1

        else:
            n += 1

    return formula


def AddSub(formula):
    
    n = 0
    
    while n < len(formula):
        if formula[n] == "+":
            ans = formula[n-1] + formula[n+1]
            formula[n-1:n+2] = [ans]
            n = n-1

        elif formula[n] == "-":
            ans = formula[n-1] - formula[n+1]
            formula[n-1:n+2] = [ans]
            n = n-1

        else:
            n += 1

    return formula


formula = input().split()

for i in range(len(formula)):
    try:
        formula[i] = float(formula[i])

    except ValueError:
        pass

if "sin" in formula or "cos" in formula or "tan" in formula:
    formula = trigonometric(formula)

formula = arithmetic(formula)

print(formula)

