import sys
import math


def arithmetic(form):
    if "*" in form or "/" in form:
        form = MulDiv(form)

    if "+" in form or "-" in form:
        form = AddSub(form)

    return form


def MulDiv(formula):

    n = 0

    while n < len(formula): 
        if formula[n] == "*":
            ans = formula[n-1] * formula[n+1]
            formula[n-1:n+2] = [ans]
            n = n-1

        elif formula[n] == "/":
            ans = formula[n-1] / formula[n+1]
            formula[n-1:n+2] = [ans]
            n = n-1

        else:
            n += 1

    return formula


def AddSub(formula):
    
    n = 0
    
    while n < len(formula):
        if formula[n] == "+":
            ans = formula[n-1] + formula[n+1]
            formula[n-1:n+2] = [ans]
            n = n-1

        elif formula[n] == "-":
            ans = formula[n-1] - formula[n+1]
            formula[n-1:n+2] = [ans]
            n = n-1

        else:
            n += 1

    return formula


formula = input().split()

for i in range(len(formula)):
    try:
        formula[i] = float(formula[i])

    except ValueError:
        pass

o = 0

while o < len(formula):
    if formula[o] == "(":
        paren = []
        first = o
        o += 1

        while formula[o] != ")":
            paren.append(formula[o])
            o += 1

        paren = arithmetic(paren)
        formula[first:o+1] = paren

    else:
        o += 1

formula = arithmetic(formula)

print(formula)

